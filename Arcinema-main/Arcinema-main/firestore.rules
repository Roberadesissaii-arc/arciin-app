rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
   function isAuth() {
     return request.auth != null;
   }

   function isOwner(userId) {
     return isAuth() && request.auth.uid == userId;
   }

  // User profiles - main user documents with all data as arrays
  match /users/{userId} {
    allow read, write: if isOwner(userId);
    allow read: if isAuth(); // Allow others to read basic profile info
    allow list: if isAuth(); // Allow querying users collection for authenticated users
  }

  // Follow relationships - tracks who follows whom
  match /follows/{followId} {
    allow read: if isAuth(); // Authenticated users can read follow relationships
    allow list: if isAuth(); // Allow querying follows collection
    allow create: if isAuth() && request.resource.data.followerId == request.auth.uid;
    allow delete: if isAuth() && resource.data.followerId == request.auth.uid;
  }

  // Folder share invites
  match /folderShareInvites/{inviteId} {
    // Allow reading your own invites (sent or received)
    allow read: if isAuth();
    allow create: if isAuth() && request.resource.data.fromUserId == request.auth.uid;
    allow update: if isAuth() && (
      resource.data.fromUserId == request.auth.uid ||
      resource.data.toUserId == request.auth.uid
    );
    allow delete: if isAuth() && resource.data.fromUserId == request.auth.uid;
  }

  // Collaborative folders - real-time sync between multiple users
  match /collaborativeFolders/{folderId} {
    // Helper function to check if user is accepting an invite
    function isAcceptingInvite() {
      // Allow if user is being added to collaborators array
      return request.auth.uid in request.resource.data.collaborators &&
             !(request.auth.uid in resource.data.collaborators);
    }
    
    // Can read if:
    // 1. You're the owner
    // 2. You're already a collaborator
    // 3. You're authenticated (to accept invites - we check permissions on update)
    allow read: if isAuth();
    
    // Can create if you're setting yourself as owner
    allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
    
    // Can update if:
    // 1. You're owner (can do anything)
    // 2. You're a collaborator (can add/remove items)
    // 3. You're accepting an invite (being added to collaborators)
    allow update: if isAuth() && (
      resource.data.ownerId == request.auth.uid ||
      request.auth.uid in resource.data.collaborators ||
      isAcceptingInvite()
    );
    
    // Can delete if you're the owner
    allow delete: if isAuth() && resource.data.ownerId == request.auth.uid;
  }   // User activities (separate collection for activity tracking)
   match /activities/{activityId} {
     allow read, write: if isAuth() && resource.data.userId == request.auth.uid;
     allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
   }

   // User lists (if stored as separate documents)
   match /userLists/{listId} {
     allow read, write: if isAuth() && resource.data.userId == request.auth.uid;
     allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
   }

  // Chat sessions
  match /chats/{chatId} {
    allow read: if isAuth() && resource.data.userId == request.auth.uid;
    allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
    allow update: if isAuth() && resource.data.userId == request.auth.uid;
    // For delete, we need to check the resource BEFORE deletion
    allow delete: if isAuth() && get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid;
    
    // Chat messages subcollection
    match /messages/{messageId} {
      // Users can read messages if they own the chat session
      // Check existence first to avoid errors on deleted chats
      allow read: if isAuth() && 
        exists(/databases/$(database)/documents/chats/$(chatId)) &&
        get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid;
      
      // Users can only create messages where they are the sender
      allow create: if isAuth() && request.resource.data.senderId == request.auth.uid;
      // Users can only update/delete their own messages
      allow update, delete: if isAuth() && resource.data.senderId == request.auth.uid;
    }
  }

  // Favorites - users can only access their own favorites
  match /favorites/{favoriteId} {
    allow read: if isAuth() && resource.data.userId == request.auth.uid;
    allow write: if isAuth() && (
      (resource != null && resource.data.userId == request.auth.uid) ||
      (resource == null && request.resource.data.userId == request.auth.uid)
    );
    allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
    allow delete: if isAuth() && resource.data.userId == request.auth.uid;
  }

  // Notifications - users can only access their own notifications
  match /notifications/{notificationId} {
    allow read: if isAuth() && (
      (resource != null && resource.data.userId == request.auth.uid) ||
      (resource == null)
    );
    // Allow creating notifications for other users (for sharing, invites, etc)
    allow create: if isAuth();
    // Allow updating/deleting only your own notifications
    allow update, delete: if isAuth() && resource.data.userId == request.auth.uid;
  }

  // New releases - read-only for authenticated users, write for system
  match /newReleases/{releaseId} {
    allow read: if isAuth();
    allow write: if false; // Only system can write (via admin SDK)
  }

  // System configuration - read-only for authenticated users
  match /system/{configId} {
    allow read: if isAuth();
    allow write: if false; // Only system can write (via admin SDK)
  }

  // Public data
   match /genres/{genreId} {
     allow read: if isAuth();
     allow write: if false;
   }

  // Blocked content - admin only writes, everyone can read for filtering
  match /blockedContent/{contentId} {
    allow read: if true; // Everyone can read to filter content
    // Only admins can write - check if user document has isAdmin flag
    allow write: if isAuth() && 
      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    allow create: if isAuth() && 
      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    allow delete: if isAuth() && 
      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
  }

  // User blocked content - users can manage their own blocks
  match /userBlockedContent/{contentId} {
    allow read: if isAuth(); // Authenticated users can read
    allow create: if isAuth(); // Authenticated users can create their blocks
    allow update: if isAuth(); // Authenticated users can update
    allow delete: if isAuth(); // Authenticated users can delete their blocks
  }

  // Blocked persons - admin only writes, everyone can read for filtering
  match /blockedPersons/{personId} {
    allow read: if true; // Everyone can read to filter content
    // Only admins can write - check if user document has isAdmin flag
    allow write: if isAuth() && 
      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    allow create: if isAuth() && 
      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    allow delete: if isAuth() && 
      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
  }

  // Spoilers - shared cache for all users
  match /spoilers/{spoilerId} {
    allow read: if true; // Everyone can read cached spoilers
    allow create: if isAuth(); // Authenticated users can create new spoilers
    allow update: if isAuth(); // Allow updates to existing spoilers
  }

  // Post Likes - social media style likes on user posts
  match /postLikes/{likeId} {
    allow read: if isAuth(); // Authenticated users can read likes
    allow list: if isAuth(); // Allow querying likes
    allow create: if isAuth() && request.resource.data.userId == request.auth.uid; // Users can only like as themselves
    allow delete: if isAuth() && resource.data.userId == request.auth.uid; // Users can only unlike their own likes
  }

  // Post Comments - comments on user posts
  match /postComments/{commentId} {
    allow read: if isAuth(); // Authenticated users can read comments
    allow list: if isAuth(); // Allow querying comments
    allow create: if isAuth() && request.resource.data.userId == request.auth.uid; // Users can only comment as themselves
    allow update: if isAuth() && resource.data.userId == request.auth.uid; // Users can only update their own comments
    allow delete: if isAuth() && (resource.data.userId == request.auth.uid || resource.data.postUserId == request.auth.uid); // Users can delete their own comments or post owners can delete comments on their posts
  }

  // User-to-user messages
  match /messages/{messageId} {
    // Users can read messages where they are sender or receiver
    allow read: if isAuth() && (
      resource.data.senderId == request.auth.uid ||
      resource.data.receiverId == request.auth.uid
    );
    // Users can list messages in conversations they're part of
    allow list: if isAuth();
    // Users can create messages where they are the sender
    allow create: if isAuth() && request.resource.data.senderId == request.auth.uid;
    // Users can update messages they received (to mark as read)
    allow update: if isAuth() && resource.data.receiverId == request.auth.uid;
  }
}
}