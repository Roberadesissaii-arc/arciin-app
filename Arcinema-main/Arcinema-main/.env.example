# =============================================================================
# Arcinema — environment template
# Copy this file to `.env.local` in the project root, then replace every
# placeholder value. Next.js loads `.env.local` automatically for `npm run dev`.
#
# Firebase web keys: Firebase Console → Project settings → Your apps → Web app
# =============================================================================

# --- App URLs ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Firebase (client — required for auth, Firestore, storage in the browser) ---
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
# Optional: Analytics
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Firebase Admin (server — required for /api routes that verify ID tokens) ---
# Option A: one JSON string (escape quotes in production; or use a file loader)
# FIREBASE_ADMIN_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
#
# Option B: individual fields from the service account JSON
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Paste the private key with literal \n for newlines, or use a single line
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- TMDB (developer.themoviedb.org — two credentials only) ---
# API Key: used for ?api_key=... query URLs (v3)
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key
# API Read Access Token: used for Authorization: Bearer ... (v3 and v4)
NEXT_PUBLIC_TMDB_API_READ_ACCESS_TOKEN=your_tmdb_read_access_token

# --- RapidAPI (IMDB proxy, where-to-watch, Netflix search) ---
NEXT_PUBLIC_RAPIDAPI_KEY=your_rapidapi_key
NEXT_PUBLIC_RAPIDAPI_HOST=imdb236.p.rapidapi.com

# --- Optional media / AI providers ---
NEXT_PUBLIC_OMDB_API_KEY=your_omdb_api_key
NEXT_PUBLIC_GEMINI_API_KEY=your_google_ai_studio_api_key
NEXT_PUBLIC_OPENAI_API_KEY=your_openai_key
NEXT_PUBLIC_XAI_API_KEY=your_xai_grok_key
NEXT_PUBLIC_DEEPSEEK_API_KEY=your_deepseek_key
# Server-only DeepSeek (email enhancement in notification pipeline)
DEEPSEEK_API_KEY=your_deepseek_key
NEXT_PUBLIC_ELEVENLABS_API_KEY=your_elevenlabs_key
